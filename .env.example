# ============================================================================
# GraphQL Coverage Proxy — переменные окружения
# Скопируйте в .env и заполните под своё окружение (файл .env в git не попадает).
# ============================================================================

# --- Сервер -----------------------------------------------------------------
# Render задаёт PORT автоматически.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# Куда складывать снапшоты схем, прогоны и покрытие.
DATA_DIR=./data
# Публичный адрес сервиса (для документации/бейджей), опционально.
PUBLIC_BASE_URL=

# --- Целевой GraphQL --------------------------------------------------------
# Единственный сервис по умолчанию. Прокси принимает запросы на /proxy и /graphql.
TARGET_GRAPHQL_URL=
# Если нужно несколько GraphQL-сервисов (gateway):
# SERVICES_JSON={"shop":{"url":"https://shop.example.com/graphql"},"crm":{"url":"https://crm.example.com/graphql"}}
SERVICES_JSON=

# --- Прокси -----------------------------------------------------------------
# Ключ доступа к /proxy. Если задан, клиент обязан прислать x-proxy-key.
PROXY_API_KEY=
# Разрешать ли клиенту подменять target через x-target-url / ?target=.
ALLOW_TARGET_OVERRIDE=false
# Allowlist хостов (csv), например: api.example.com,*.staging.example.com
ALLOWED_TARGET_HOSTS=
# Разрешать запросы к localhost/приватным сетям (включайте только локально).
ALLOW_PRIVATE_TARGETS=true
UPSTREAM_TIMEOUT_MS=20000
MAX_BODY_MB=8
MAX_RESPONSE_MB=16
MAX_QUERY_CHARS=200000
# Валидировать запросы по схеме и не пускать невалидные к upstream.
PROXY_STRICT_VALIDATION=false
# Дополнительные заголовки к upstream/ответу (JSON).
PROXY_EXTRA_HEADERS={}
PROXY_EXTRA_RESPONSE_HEADERS={}

# --- Админка ----------------------------------------------------------------
# Если задан, изменяющие эндпоинты (/api/schema/*, /api/ingest, /api/state/*)
# требуют заголовок x-admin-token.
ADMIN_TOKEN=

# --- Схема ------------------------------------------------------------------
# Автоматически забирать схему при старте, если снапшотов ещё нет.
AUTO_INTROSPECT=true
# URL для introspection (по умолчанию TARGET_GRAPHQL_URL).
SCHEMA_INTROSPECT_URL=
# Сервис, к которому относится автоматически загруженная схема.
SCHEMA_SERVICE=default
# Заголовки для introspection (JSON), например авторизация.
SCHEMA_INTROSPECT_HEADERS={}

# --- Хранение ---------------------------------------------------------------
# Сколько дней хранить журнал исполнений (JSONL).
RETENTION_DAYS=30
# За сколько дней искать запросы в журнале (drill-down).
EXECUTION_LOOKBACK_DAYS=14
# Максимум прогонов, которые склеиваются в один срез покрытия.
MAX_RUNS_IN_MERGE=200

# --- Прочее -----------------------------------------------------------------
# daily — авто-прогон на день, session — один на ветку/окружение, off — «adhoc».
AUTO_RUN_MODE=daily
# Демо-схема и демо-прогоны на пустом хранилище.
DEMO_MODE=false
CORS_ORIGIN=*
